  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 09d9dd0205bab0640872e2256248d999, type: 3}
  m_Name: M2 Briefing
  m_EditorClassIdentifier: 
  _source: {fileID: 4900000, guid: 66f9abd96e734c09a0c77e3ed3a72bfa, type: 3}
  _sourcePath: Assets/Leveraged Wars Story/2. Missions/M2-Reclaim the Village/M2
    Briefing.md
  _warnings: []
  _lines:
  - Speaker: Bard
    Text: 'From distant roads, with but a faithful few,

      Prince Julian returned
      unto his hearth;

      The tyranny tax farmers wrought in greed

      Brought
      great disquiet to his heavy heart.'
    WordsPerMinute: 0
    SpeakerSide: 1
    LeftName: Bard
    RightName: 
    LeftPortrait: {fileID: 7468356559241021412, guid: b23a63486994642469fcc255da0779d2,
      type: 3}
    RightPortrait: {fileID: 0}
  - Speaker: Bard
    Text: 'He wept to see a household starve for bread,

      Their father called
      away to foreign war;

      Their daughter Joan, wracked with whooping cough,

      He
      healed at once with but a gentle touch.'
    WordsPerMinute: 0
    SpeakerSide: 1
    LeftName: Bard
    RightName: 
    LeftPortrait: {fileID: 7468356559241021412, guid: b23a63486994642469fcc255da0779d2,
      type: 3}
    RightPortrait: {fileID: 0}
  - Speaker: Bard
    Text: 'Yet sworn from birth unto his father''s laws,

      He planned to beg
      dear uncle Claudius

      To chastise these black knights and stay their hand.'
    WordsPerMinute: 0
    SpeakerSide: 1
    LeftName: Bard
    RightName: 
    LeftPortrait: {fileID: 7468356559241021412, guid: b23a63486994642469fcc255da0779d2,
      type: 3}
    RightPortrait: {fileID: 0}
  - Speaker: Bard
    Text: 'Not till he saw the sack of Hira''s shrine

      Did he perceive that
      Pisco fooled the king.'
    WordsPerMinute: 0
    SpeakerSide: 1
    LeftName: Bard
    RightName: 
    LeftPortrait: {fileID: 7468356559241021412, guid: b23a63486994642469fcc255da0779d2,
      type: 3}
    RightPortrait: {fileID: 0}
  - Speaker: Bard
    Text: 'As loyal folk of fair Aurelliam,

      Both men and women, rise at duty''s
      call

      To join Prince Julian in staunch defence

      Against such wanton
      banditry; bring down

      Their reign, and cast these thieves from out our
      town!'
    WordsPerMinute: 0
    SpeakerSide: 1
    LeftName: Bard
    RightName: 
    LeftPortrait: {fileID: 7468356559241021412, guid: b23a63486994642469fcc255da0779d2,
      type: 3}
    RightPortrait: {fileID: 0}
