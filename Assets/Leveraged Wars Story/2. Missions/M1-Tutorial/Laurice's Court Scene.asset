  _lines:
  - Speaker: Laurice
    Text: Do you think this is Claudius' work Julian?
    WordsPerMinute: 0
    SpeakerSide: 1
    LeftName: Laurice
    RightName: 
    LeftPortrait: {fileID: -3154334995067897491, guid: 08ed030703cd4f04ca27434672621d8b,
      type: 3}
